{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tir",
  "version": "0.1.4-beta",
  "identifier": "com.ramin1886.tir",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tir",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://github.com https://gitlab.com; connect-src 'self' tauri: ipc: https://api.github.com https://gitlab.com;"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5NTAzREMzQTNDQTY1MkIKUldTcUtuWER3OVRwK3RCSGwwbS9KckJ2N2NWRWkxaWUyTUhVMkx1V3gwaUtoMlpTMFpMTkF1Sk8K",
      "endpoints": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage", "app", "dmg"],
    "publisher": "Ramin1886",
    "shortDescription": "A modern, fast, and visual Git GUI client.",
    "longDescription": "A modern, fast, and visual Git GUI client.",
    "license": "GPL-2.0",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
